# Copiar a .env para desarrollo local.
ENTORNO=development            # production exige SECRET_KEY propia y PostgreSQL
DATABASE_URL=sqlite:///./anemia_dev.db
# Producción (Render la enlaza sola): postgresql://usuario:clave@host:5432/anemia
SECRET_KEY=cambiar-por-una-clave-larga-aleatoria-de-32-o-mas-caracteres
TOKEN_MINUTOS=480
CORS_ORIGENES=*                # p. ej. https://miapp.com,https://otra.com
# RUTA_MODELO=modelos/modelo_anemia_rf.pkl
SEED_DEMO=true
DEMO_USUARIO=demo
DEMO_CONTRASENA=demo
DEMO_NOMBRE=Dra. Demo
DEMO_ROL=médico
